{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-meds",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "home-meds",
    "database_id": "ea7a5d9e-45f3-4409-adda-2214882f7d4e",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BLIegy6jlROnqmPFe87zyBD3j5m-v1qvwIseRzbzfiBfkWCJb3GXdUXyGUSFm-JeMwXrgT3FJPrxYZtiE7NdZZQ",
    "VAPID_SUBJECT": "https://home-meds.chemicalbond007.workers.dev"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
