{
  "name": "home-meds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:pages": "cd pages && wrangler pages functions build --outdir ../.wrangler/pages-check",
    "test": "vitest run",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply home-meds --local",
    "db:demo": "wrangler d1 execute home-meds --local --file tests/fixtures/demo.sql",
    "db:remote": "wrangler d1 migrations apply home-meds --remote",
    "deploy": "npm run build && npm run deploy:worker && npm run deploy:pages",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "cd pages && wrangler pages deploy --branch main",
    "admin:create": "node scripts/admin-create.mjs",
    "probe:ai": "node --env-file-if-exists=.dev.vars scripts/probe-ai.mjs",
    "vapid:generate": "node scripts/vapid.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "hono": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.0",
    "zxing-wasm": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
